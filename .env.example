# ==============================================================================
# RetrievalForge - Advanced Retrieval RAG Configuration
# ==============================================================================

# LLM Provider Configuration (OpenAI or any OpenAI-compatible API)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# Embedding Model Configuration
# Options: HuggingFace model (e.g. all-MiniLM-L6-v2) or OpenAI (text-embedding-3-small)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# If EMBEDDING_PROVIDER=openai, set OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Reranker Model Configuration
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Document Chunking Hyperparameters
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Retrieval Defaults
DEFAULT_TOP_K=5
CANDIDATE_POOL_K=20

# MMR (Maximal Marginal Relevance) Hyperparameters
MMR_FETCH_K=20
MMR_LAMBDA=0.7

# Hybrid Search Fusion Parameters
RRF_K=60
HYBRID_DENSE_WEIGHT=0.5
HYBRID_SPARSE_WEIGHT=0.5

# Post-Retrieval Reranking & Compression
RERANK_TOP_K=5
COMPRESSION_ENABLED=false
COMPRESSION_SIMILARITY_THRESHOLD=0.7

# Query Transformation Hyperparameters
MULTI_QUERY_COUNT=3
QUERY_EXPANSION_COUNT=3

# Paths & Directories
DOCUMENTS_DIR=data/documents
FAISS_INDEX_PATH=data/storage/faiss_index
BM25_INDEX_PATH=data/storage/bm25_index.pkl
EVAL_DATASET_PATH=data/evaluation/eval_dataset.json
EVAL_RESULTS_PATH=data/evaluation/results.json

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ==============================================================================
# Git Ignore Rules for RetrievalForge
# ==============================================================================

# Virtual Environments (never push local python environment)
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python Bytecode and Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Secrets and Environment Variables (Keep .env.example, never push .env)
.env
.env.local
.env.*.local

# Operating System & IDE Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# Pytest and Test Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# HuggingFace & Torch local download caches
.cache/
hf_cache/

# Generated Local Index Storage (Index files can be recreated via python scripts/ingest.py)
data/storage/*
!data/storage/.gitkeep

# Generated Evaluation Results (Generated during benchmark runs)
data/evaluation/results.json
data/evaluation/results.csv
